# Provider secrets. Keep real values in .env.local for local development and
# in Sites environment variables for the hosted app.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Provider-neutral role seats can use any configured model ID.
OPENAI_MODEL=gpt-5.6-luna
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.6-flash

# Estimated standard API prices per million tokens. These are display-only and
# should be refreshed when provider pricing changes.
OPENAI_INPUT_USD_PER_MTOK=1
OPENAI_OUTPUT_USD_PER_MTOK=6
ANTHROPIC_INPUT_USD_PER_MTOK=2
ANTHROPIC_OUTPUT_USD_PER_MTOK=10
GEMINI_INPUT_USD_PER_MTOK=1.5
GEMINI_OUTPUT_USD_PER_MTOK=7.5
